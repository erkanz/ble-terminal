<Window x:Class="BLESerialTerminal.KissTcpBridgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KISS TCP Bridge" Width="980" Height="700" MinWidth="820" MinHeight="560"
        Icon="Assets/BLESerialTerminal.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="KISS TCP Bridge" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="BLE KISS RX is forwarded unchanged to TCP clients. TCP KISS bytes are written through the active connection's safe BLE GATT pipeline. Auto Detect's baseline write characteristic is preferred, so a temporary RT-950 FF31 diagnostic route does not redirect KISS TCP traffic."/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="Bridge is OFF by default. Closing this window stops the listener. LAN binding requires explicit confirmation."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Bind:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="BindComboBox" Grid.Column="1" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Localhost only (127.0.0.1)"/>
                    <ComboBoxItem Content="LAN / all interfaces (0.0.0.0)"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="PortTextBox" Grid.Column="3" Text="8001" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="StartButton" Grid.Column="4" Content="Start bridge" Width="105" Margin="0,0,8,0" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Grid.Column="5" Content="Stop" Width="80" IsEnabled="False" Click="StopButton_Click"/>
                <TextBlock x:Name="StateTextBlock" Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="STOPPED"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="4">
                    <TextBlock x:Name="EndpointTextBlock" Text="Endpoint: -"/>
                    <TextBlock x:Name="BleTextBlock" Text="BLE: unavailable"/>
                    <TextBlock x:Name="ClientsTextBlock" Text="Clients: 0"/>
                    <TextBlock x:Name="BackpressureTextBlock" Text="Backpressure disconnects: 0"/>
                </UniformGrid>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,6,0,0">
                    <TextBlock x:Name="BleRxTextBlock" Text="BLE→TCP: 0 B / 0 frames"/>
                    <TextBlock x:Name="TcpOutTextBlock" Text="TCP sent: 0 B"/>
                    <TextBlock x:Name="TcpRxTextBlock" Text="TCP→BLE: 0 B / 0 frames"/>
                    <TextBlock x:Name="BleTxTextBlock" Text="BLE written: 0 B / reject 0"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Bridge events" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Clear" Width="80" Click="ClearButton_Click"/>
                </DockPanel>
                <DataGrid x:Name="EventGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="120"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                        <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="BLESerialTerminal.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose color"
        Width="410" Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Icon="Assets/BLESerialTerminal.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="HEX:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="HexTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                     TextChanged="HexTextBox_TextChanged"/>
            <Border x:Name="PreviewBorder" Grid.Column="2" Margin="10,0,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Presets" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"/>

        <WrapPanel Grid.Row="3" Margin="0,0,0,12">
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#000000" Tag="#000000" Click="PresetButton_Click" ToolTip="#000000"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#060A0F" Tag="#060A0F" Click="PresetButton_Click" ToolTip="#060A0F"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#111111" Tag="#111111" Click="PresetButton_Click" ToolTip="#111111"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#1F2937" Tag="#1F2937" Click="PresetButton_Click" ToolTip="#1F2937"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#FFFFFF" Tag="#FFFFFF" Click="PresetButton_Click" ToolTip="#FFFFFF"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#E8E8E8" Tag="#E8E8E8" Click="PresetButton_Click" ToolTip="#E8E8E8"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#D7F9FF" Tag="#D7F9FF" Click="PresetButton_Click" ToolTip="#D7F9FF"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#4CC9F0" Tag="#4CC9F0" Click="PresetButton_Click" ToolTip="#4CC9F0"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#22C55E" Tag="#22C55E" Click="PresetButton_Click" ToolTip="#22C55E"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#FACC15" Tag="#FACC15" Click="PresetButton_Click" ToolTip="#FACC15"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#F97316" Tag="#F97316" Click="PresetButton_Click" ToolTip="#F97316"/>
            <Button Width="48" Height="34" Margin="0,0,6,6" Background="#A855F7" Tag="#A855F7" Click="PresetButton_Click" ToolTip="#A855F7"/>
        </WrapPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="ValidationTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#EF4444"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True"/>
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Width="80" Height="30" IsDefault="True" Click="OkButton_Click"/>
        </DockPanel>
    </Grid>
</Window>

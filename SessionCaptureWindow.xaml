<Window x:Class="BLESerialTerminal.SessionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Capture / Offline Replay" Height="820" Width="1380"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="StartCaptureButton" Content="Start Capture" Width="105" Click="StartCaptureButton_Click"/>
                    <Button x:Name="StopCaptureButton" Content="Stop" Width="75" Margin="8,0,0,0" Click="StopCaptureButton_Click" IsEnabled="False"/>
                    <Button x:Name="SaveSessionButton" Content="Save Session..." Width="115" Margin="8,0,0,0" Click="SaveSessionButton_Click" IsEnabled="False"/>
                    <TextBlock Text="Capture:" Margin="16,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CaptureStateTextBlock" Text="STOPPED" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Events:" Margin="16,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CaptureCountTextBlock" Text="0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Replay is offline only: captured TX events are NEVER transmitted to BLE."
                           Foreground="{DynamicResource MutedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="LoadSessionButton" Content="Load Session..." Width="115" Click="LoadSessionButton_Click"/>
                    <Button x:Name="PlayButton" Content="Play" Width="70" Margin="8,0,0,0" Click="PlayButton_Click" IsEnabled="False"/>
                    <Button x:Name="PauseButton" Content="Pause" Width="70" Margin="8,0,0,0" Click="PauseButton_Click" IsEnabled="False"/>
                    <Button x:Name="StepButton" Content="Step" Width="70" Margin="8,0,0,0" Click="StepButton_Click" IsEnabled="False"/>
                    <Button x:Name="ResetReplayButton" Content="Reset" Width="70" Margin="8,0,0,0" Click="ResetReplayButton_Click" IsEnabled="False"/>
                    <TextBlock Text="Speed:" Margin="16,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ReplaySpeedComboBox" Width="85" SelectedIndex="2">
                        <ComboBoxItem Content="0.25x" Tag="0.25"/>
                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                        <ComboBoxItem Content="1x" Tag="1"/>
                        <ComboBoxItem Content="2x" Tag="2"/>
                        <ComboBoxItem Content="5x" Tag="5"/>
                        <ComboBoxItem Content="10x" Tag="10"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="ReplayStateTextBlock" DockPanel.Dock="Right" Text="No session loaded" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Loaded / replayed structured events" FontWeight="SemiBold" Margin="2,0,0,5"/>
                    <DataGrid x:Name="EventGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="105"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95"/>
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="45"/>
                            <DataGridTextColumn Header="Char" Binding="{Binding Characteristic}" Width="105"/>
                            <DataGridTextColumn Header="Bytes" Binding="{Binding DataLength}" Width="55"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Offline replay KISS / AX.25 / APRS results" FontWeight="SemiBold" Margin="2,0,0,5"/>
                    <DataGrid x:Name="DecodedGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DecodedGrid_SelectionChanged"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="105"/>
                            <DataGridTextColumn Header="Char" Binding="{Binding Characteristic}" Width="100"/>
                            <DataGridTextColumn Header="KISS" Binding="{Binding KissText}" Width="70"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="100"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Session metadata" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="MetadataTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Selected replay packet" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="ReplayDetailTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4">
            <StatusBarItem><TextBlock x:Name="ReplayProgressTextBlock" Text="Replay 0 / 0"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="ReplayCountersTextBlock" Text="RX 0 events / 0 bytes   KISS 0"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

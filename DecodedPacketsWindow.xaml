<Window x:Class="BLESerialTerminal.DecodedPacketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decoded KISS / AX.25 / APRS Packets"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock x:Name="CountTextBlock" DockPanel.Dock="Left"
                           Text="Decoded packets: 0" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy detail" Width="100" Margin="0,0,8,0" Click="CopyDetailButton_Click"/>
                    <Button Content="Export..." Width="90" Margin="0,0,8,0" Click="ExportButton_Click"/>
                    <Button Content="Clear" Width="80" Click="ClearButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="PacketGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,8"
                  SelectionChanged="PacketGrid_SelectionChanged"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="105"/>
                <DataGridTextColumn Header="BLE" Binding="{Binding Characteristic}" Width="90"/>
                <DataGridTextColumn Header="KISS" Binding="{Binding KissText}" Width="75"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="120"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="200"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="170"/>
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="DetailTextBox" Grid.Row="2" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource TerminalBackgroundBrush}"
                 Foreground="{DynamicResource TerminalForegroundBrush}"
                 Padding="8"/>

        <TextBlock Grid.Row="3" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Text="Pipeline: RAW BLE notification → KISS reassembly → AX.25 decode → APRS decode. Raw lower-layer data is retained even when a higher layer cannot be decoded."/>
    </Grid>
</Window>

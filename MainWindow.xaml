<Window x:Class="BLESerialTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLE Serial Terminal" Height="840" Width="1220"
        Icon="Assets/BLESerialTerminal.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <Menu DockPanel.Dock="Top" Height="28" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="Export Log..." Click="ExportLogMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="DarkModeMenuItem" Header="Dark mode" IsCheckable="True" Click="DarkModeMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Decoded KISS / AX.25 / APRS packets..." Click="DecodedPacketsMenuItem_Click"/>
                <MenuItem Header="BLE Notification Monitor..." Click="NotificationMonitorMenuItem_Click"/>
                <MenuItem Header="Diagnostic Log Filters / Search..." Click="LogFilterMenuItem_Click"/>
                <MenuItem Header="Session Capture / Offline Replay..." Click="SessionCaptureMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Serial output background..." Click="TerminalBackgroundMenuItem_Click"/>
                <MenuItem Header="Serial output text color..." Click="TerminalForegroundMenuItem_Click"/>
                <MenuItem Header="Reset serial output colors" Click="ResetTerminalColorsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Number of TX command rows">
                    <MenuItem x:Name="TxRows1MenuItem" Header="1" Tag="1" IsCheckable="True" Click="TxCommandRowCountMenuItem_Click"/>
                    <MenuItem x:Name="TxRows2MenuItem" Header="2" Tag="2" IsCheckable="True" Click="TxCommandRowCountMenuItem_Click"/>
                    <MenuItem x:Name="TxRows3MenuItem" Header="3" Tag="3" IsCheckable="True" Click="TxCommandRowCountMenuItem_Click"/>
                    <MenuItem x:Name="TxRows4MenuItem" Header="4" Tag="4" IsCheckable="True" Click="TxCommandRowCountMenuItem_Click"/>
                    <MenuItem x:Name="TxRows5MenuItem" Header="5" Tag="5" IsCheckable="True" Click="TxCommandRowCountMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="About BLE Serial Terminal" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Device filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="FilterTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"
                             ToolTip="Optional name/address filter" TextChanged="FilterTextBox_TextChanged"/>
                    <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" Width="90" Height="30" Margin="0,0,8,0" Click="ScanButton_Click"/>
                    <Button x:Name="ConnectButton" Grid.Column="3" Content="Connect" Width="100" Height="30" Margin="0,0,8,0" Click="ConnectButton_Click"/>
                    <Button x:Name="DisconnectButton" Grid.Column="4" Content="Disconnect" Width="100" Height="30" Margin="0,0,8,0" Click="DisconnectButton_Click" IsEnabled="False"/>
                    <Button x:Name="GattInspectorButton" Grid.Column="5" Content="GATT Inspector" Width="110" Height="30" Margin="0,0,10,0" Click="GattInspectorButton_Click" IsEnabled="False"/>
                    <CheckBox x:Name="AutoReconnectCheckBox" Grid.Column="6" Content="Auto reconnect" VerticalAlignment="Center" IsChecked="True"/>
                </Grid>
            </Border>

            <DataGrid x:Name="DeviceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,8"
                      MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="BLE Address" Binding="{Binding AddressText}" Width="180"/>
                    <DataGridTextColumn Header="RSSI" Binding="{Binding RssiText}" Width="90"/>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Expander Grid.Row="2" Header="GATT / UART profile" IsExpanded="False" Margin="0,0,0,8">
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="AutoDetectGattCheckBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                  Content="Auto detect BLE-UART GATT profile (recommended)" IsChecked="True" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Service UUID:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox x:Name="ServiceUuidTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,6" Text="6E400001-B5A3-F393-E0A9-E50E24DCCA9E"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Write UUID:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox x:Name="WriteUuidTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" Text="6E400002-B5A3-F393-E0A9-E50E24DCCA9E"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Notify UUID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="NotifyUuidTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" Text="6E400003-B5A3-F393-E0A9-E50E24DCCA9E"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="TX chunk bytes:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ChunkSizeTextBox" Grid.Row="2" Grid.Column="3" Width="70" HorizontalAlignment="Left" Text="20"/>
                    </Grid>
                </Border>
            </Expander>

            <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="RX view:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="RxViewComboBox" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="ASCII"/>
                                <ComboBoxItem Content="HEX"/>
                                <ComboBoxItem Content="ASCII + HEX"/>
                            </ComboBox>
                            <CheckBox x:Name="TimestampCheckBox" Content="Timestamp" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                            <CheckBox x:Name="AutoScrollCheckBox" Content="Auto scroll" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Clear RX" Width="90" Margin="0,0,8,0" Click="ClearRxButton_Click"/>
                            <Button Content="Save log" Width="90" Click="SaveLogButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="TerminalTextBox" Grid.Row="1" FontFamily="Consolas" FontSize="13"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalForegroundBrush}" Padding="8"/>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Service:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ServiceRouteComboBox" Width="90" Margin="0,0,12,0"/>
                        <TextBlock Text="Notify characteristic:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="NotifyRouteComboBox" Width="220" DisplayMemberPath="Display" Margin="0,0,12,0"
                                  SelectionChanged="NotifyRouteComboBox_SelectionChanged"/>
                        <TextBlock Text="Write characteristic:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="WriteRouteComboBox" Width="220" DisplayMemberPath="Display" Margin="0,0,12,0"
                                  SelectionChanged="WriteRouteComboBox_SelectionChanged"/>
                        <TextBlock Text="Write type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="WriteTypeComboBox" Width="150" SelectedIndex="0" SelectionChanged="WriteTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="With Response"/>
                            <ComboBoxItem Content="Without Response"/>
                        </ComboBox>
                    </WrapPanel>
                    <DockPanel Grid.Row="1" Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="RT950 OEM TEST" Width="125" Margin="0,0,8,0" Click="Rt950OemPresetButton_Click"/>
                            <Button Content="RT950 FFE1 TEST" Width="125" Margin="0,0,8,0" Click="Rt950Ffe1PresetButton_Click"/>
                            <Button Content="Load RT950 Test Commands" Width="180" Margin="0,0,10,0" Click="LoadRt950TestCommandsButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RoutingStatusTextBlock" Text="Connect to populate live GATT routing." Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TX mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TxModeComboBox" Grid.Column="1" Width="85" SelectedIndex="0" Margin="0,0,12,0">
                        <ComboBoxItem Content="ASCII"/>
                        <ComboBoxItem Content="HEX"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="Line ending:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="LineEndingComboBox" Grid.Column="3" Width="85" SelectedIndex="2" Margin="0,0,12,0">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="CR"/>
                        <ComboBoxItem Content="LF"/>
                        <ComboBoxItem Content="CRLF"/>
                    </ComboBox>
                    <TextBlock Grid.Column="4" Text="HEX accepts: 01 A0 FF or 01A0FF. NONE adds no bytes." Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="LocalEchoCheckBox" Grid.Column="5" Content="Local echo" VerticalAlignment="Center" IsChecked="False"/>
                </Grid>
            </Border>

            <Expander x:Name="TxCommandsExpander" Grid.Row="6" Header="TX commands (1)" IsExpanded="True" MaxHeight="190" Margin="0,0,0,8">
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170">
                        <StackPanel>
                            <Grid x:Name="CommandRow1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandLabel1TextBox" Grid.Column="0" Text="Command 1" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged"/>
                                <TextBox x:Name="TxTextBox" Grid.Column="1" Tag="1" FontFamily="Consolas" FontSize="13" AcceptsReturn="False" Padding="6" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged" PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"/>
                                <Button x:Name="SendButton" Grid.Column="2" Tag="1" Content="Send 1" Click="SendCommandSlotButton_Click" IsEnabled="False"/>
                            </Grid>
                            <Grid x:Name="CommandRow2" Margin="0,0,0,5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandLabel2TextBox" Grid.Column="0" Text="Command 2" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged"/>
                                <TextBox x:Name="TxTextBox2" Grid.Column="1" Tag="2" FontFamily="Consolas" FontSize="13" AcceptsReturn="False" Padding="6" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged" PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"/>
                                <Button x:Name="SendButton2" Grid.Column="2" Tag="2" Content="Send 2" Click="SendCommandSlotButton_Click" IsEnabled="{Binding IsEnabled, ElementName=SendButton}"/>
                            </Grid>
                            <Grid x:Name="CommandRow3" Margin="0,0,0,5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandLabel3TextBox" Grid.Column="0" Text="Command 3" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged"/>
                                <TextBox x:Name="TxTextBox3" Grid.Column="1" Tag="3" FontFamily="Consolas" FontSize="13" AcceptsReturn="False" Padding="6" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged" PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"/>
                                <Button x:Name="SendButton3" Grid.Column="2" Tag="3" Content="Send 3" Click="SendCommandSlotButton_Click" IsEnabled="{Binding IsEnabled, ElementName=SendButton}"/>
                            </Grid>
                            <Grid x:Name="CommandRow4" Margin="0,0,0,5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandLabel4TextBox" Grid.Column="0" Text="Command 4" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged"/>
                                <TextBox x:Name="TxTextBox4" Grid.Column="1" Tag="4" FontFamily="Consolas" FontSize="13" AcceptsReturn="False" Padding="6" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged" PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"/>
                                <Button x:Name="SendButton4" Grid.Column="2" Tag="4" Content="Send 4" Click="SendCommandSlotButton_Click" IsEnabled="{Binding IsEnabled, ElementName=SendButton}"/>
                            </Grid>
                            <Grid x:Name="CommandRow5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandLabel5TextBox" Grid.Column="0" Text="Command 5" Margin="0,0,6,0" VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged"/>
                                <TextBox x:Name="TxTextBox5" Grid.Column="1" Tag="5" FontFamily="Consolas" FontSize="13" AcceptsReturn="False" Padding="6" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" TextChanged="CommandPreferenceTextChanged" PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"/>
                                <Button x:Name="SendButton5" Grid.Column="2" Tag="5" Content="Send 5" Click="SendCommandSlotButton_Click" IsEnabled="{Binding IsEnabled, ElementName=SendButton}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Expander>

            <StatusBar Grid.Row="7">
                <StatusBarItem>
                    <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="ConnectionTextBlock" Text="Disconnected"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="CountersTextBlock" Text="RX 0 B   TX 0 B"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>
